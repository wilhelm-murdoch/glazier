# Three windows with three, one and two panes, each with a name.
session {
  name = "three-windows"
  window {
    name   = "w1"
    layout = "even-horizontal"
    pane {
      name = "a"
    }
    pane {
      name = "b"
    }
    pane {
      name = "c"
    }
  }
  window {
    name = "w2"
    pane {
      name = "d"
    }
  }
  window {
    name   = "w3"
    layout = "even-vertical"
    pane {
      name = "e"
    }
    pane {
      name = "f"
    }
  }
}
